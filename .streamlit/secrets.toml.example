# Copiază fișierul ca „secrets.toml” (în același folder) și completează-l din Auth0.
# secrets.toml NU se urcă pe GitHub.
# Fără acest fișier, aplicația merge cu intrarea demo prin numărul de telefon.

[auth]
# Pe laptop: http://localhost:8501/oauth2callback
# Pe server:  https://DOMENIUL-TAU/oauth2callback   (trebuie pus și în Auth0 la „Allowed Callback URLs”)
redirect_uri = "http://localhost:8501/oauth2callback"
# Un șir lung și aleatoriu. Îl poți genera cu:  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "SCHIMBA-MA-cu-un-sir-lung-si-aleatoriu"

[auth.auth0]
client_id = "din Auth0 > Applications > SKILLIO > Settings > Client ID"
client_secret = "din Auth0 > Applications > SKILLIO > Settings > Client Secret"
# Înlocuiește DOMENIUL-TAU cu „Domain” din aceeași pagină (ex. dev-abc123.eu.auth0.com)
server_metadata_url = "https://DOMENIUL-TAU/.well-known/openid-configuration"
client_kwargs = { "prompt" = "login" }
